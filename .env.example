# Окружение ЛК. Читается при запуске (server/utils/env.ts), в образ не запекается.
# Выкат и где что задавать — docs/DEPLOY.md.

# --- Битрикс24 (коробка) ---
# Входящий вебхук коробки поставщика: https://<портал>/rest/<id>/<код>/
# На ВМ клиента — внутренний адрес портала. Права — docs/spec.md (crm, placement, user_brief).
B24_WEBHOOK_URL=

# --- 1С ---
# true — мок по контракту docs/onec-contract.md (server/routes/mock-1c/*, этап 1).
ONEC_MOCK=true
ONEC_URL=
ONEC_TOKEN=

# --- ИИ-помощник (этап 5) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Секреты сервера ---
# Подпись сессий клиентов: openssl rand -hex 32. Копию храните вне сервера.
SESSION_SECRET=
# Bearer для /mcp/admin: openssl rand -hex 32. Пусто — /mcp/admin закрыт для всех.
MCP_ADMIN_TOKEN=

# --- Прод за nginx-proxy (docker-compose.prod.yml) ---
DOMAIN=wsp.algena.by
LETSENCRYPT_EMAIL=
