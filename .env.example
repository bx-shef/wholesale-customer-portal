# Окружение ЛК. Читается при запуске (server/utils/env.ts), в образ не запекается.
# Выкат и где что задавать — docs/DEPLOY.md.

# --- Битрикс24 (коробка) ---
# ЛК работает с коробкой как ЛОКАЛЬНОЕ ПРИЛОЖЕНИЕ (вебхук не используется): ключи — из карточки
# приложения в коробке (Разработчикам → Другое → Локальное приложение), docs/DEPLOY_BITRIXVM.md.
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Хост портала коробки без https:// (crm.example.by). Обязателен: установку приложения и вкладку
# «Личный кабинет» сервер принимает только от него. На ВМ Битрикс24 по нему же контейнер ходит к
# порталу на эту же машину (deploy/bitrixvm/docker-compose.bitrixvm.yml, extra_hosts).
B24_PORTAL_HOST=

# --- 1С ---
# true — мок по контракту docs/onec-contract.md (server/routes/mock-1c/*, этап 1).
ONEC_MOCK=true
# Мок 1С: GUID настоящих компаний CRM через запятую — мок выдаст им демо-договор, адрес и цены.
ONEC_MOCK_CLIENTS=
# Токен 1С; при ONEC_MOCK=true — токен мока /mock-1c (пусто — мок закрыт снаружи, ЛК работает).
ONEC_URL=
ONEC_TOKEN=
# Или логин и пароль пользователя 1С (Basic-авторизация) — тогда ONEC_TOKEN не нужен.
ONEC_LOGIN=
ONEC_PASSWORD=
# Транспорт 1С: пусто или http — HTTP-сервис по контракту; odata — стандартный OData
# (ONEC_URL = https://…/<база>/odata/standard.odata, логин и пароль — ONEC_LOGIN/ONEC_PASSWORD).
# ONEC_MOCK=true перекрывает odata. По OData пока каталог, картинки, цены, остатки и клиенты; заказы и рейсы — следующие шаги.
ONEC_MODE=
# Виды цен по наименованию (OData), через запятую; пусто — все виды цен
ONEC_PRICE_TYPES=
# Склады, остаток которых видит клиент (OData), через запятую; пусто — «Основной склад»
ONEC_STOCK_WAREHOUSES=

# --- ИИ-помощник (этап 5) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Секреты сервера ---
# Подпись сессий клиентов, не короче 32 символов: openssl rand -hex 32. Копию храните вне сервера.
# Смена секрета разлогинивает всех клиентов.
SESSION_SECRET=
# Bearer для /mcp/admin: openssl rand -hex 32. Пусто — /mcp/admin закрыт для всех.
MCP_ADMIN_TOKEN=
# Пароль стенда проверки сервиса 1С https://<домен>/api/onec-test (docs/onec-contract.md §3); пусто — стенд закрыт.
ONEC_TEST_PASSWORD=
# Логин стенда; пусто — подойдёт любой логин с верным паролем.
ONEC_TEST_LOGIN=

# --- Прод за nginx-proxy (docker-compose.prod.yml) ---
# TRUST_PROXY=1 задан в compose: адрес клиента для лимита входа — из X-Forwarded-For.
DOMAIN=wsp.algena.by
LETSENCRYPT_EMAIL=

# --- Оповещения оператору (Telegram) и «Состояние системы» ---
# Обмен с 1С встал, падает или 1С на паузе — одно сообщение на поломку и одно на восстановление.
# Обе переменные обязательны; пусто — оповещения выключены. Токен — от @BotFather, в журнал не пишется.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Адрес ЛК снаружи: ссылка на /api/system в оповещениях.
PUBLIC_URL=
