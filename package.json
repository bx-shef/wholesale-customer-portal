{
  "name": "wholesale-customer-portal",
  "type": "module",
  "private": true,
  "description": "Личный кабинет оптового клиента: каталог с ценой клиента и остатками, заявки, дата машины, ИИ-помощник. Битрикс24 (коробка) + 1С.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bx-shef/wholesale-customer-portal.git"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc --ignoreConfig --noEmit --module esnext --moduleResolution bundler --target es2022 --skipLibCheck --types node scripts/*.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "b24:setup": "tsx scripts/b24-setup.ts",
    "postinstall": "nuxt prepare",
    "test:contract": "vitest run tests/contract",
    "onec:openapi": "tsx scripts/onec-openapi.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.82",
    "@ai-sdk/vue": "^4.0.148",
    "@bitrix24/b24icons-vue": "^2.0.8",
    "@bitrix24/b24jssdk": "^3.0.0",
    "@bitrix24/b24ui-nuxt": "^2.15.0",
    "@nuxt/content": "^3.16.2",
    "@nuxtjs/mcp-toolkit": "^0.24.1",
    "ai": "^7.0.152",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  }
}
